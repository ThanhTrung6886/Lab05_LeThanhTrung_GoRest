          "name": "Request 1 – POST User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const name = pm.iterationData.get(\"name\");\r\nconst gender = pm.iterationData.get(\"gender\");\r\nconst email = pm.iterationData.get(\"email\");\r\nconst status = pm.iterationData.get(\"status\");\r\n\r\npm.variables.set(\"name\", name);\r\npm.variables.set(\"gender\", gender);\r\npm.variables.set(\"email\", email);\r\npm.variables.set(\"status\", status);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const user = pm.response.json();\r\n    pm.environment.set(\"userId\", String(user.id));\r\n    pm.environment.set(\"userEmail\", user.email);\r\n}"
                ]
              }
            }
          ],
